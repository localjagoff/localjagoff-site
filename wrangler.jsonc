{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "localjagoff-review",
  "account_id": "3ba52abcb44be302ce5b6d5f695474d8",
  "main": ".open-next/prewarm-worker.js",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {"directory": ".open-next/assets", "binding": "ASSETS"},
  "services": [{"binding": "WORKER_SELF_REFERENCE", "service": "localjagoff-review"}],
  "durable_objects": {"bindings":[{"name":"COMMERCE_EXECUTOR","class_name":"CommerceExecutor"}]},
  "migrations": [{"tag":"commerce-executor-v1","new_sqlite_classes":["CommerceExecutor"]}],
  "d1_databases": [{"binding":"PUBLIC_CATALOG_DB","database_name":"localjagoff-catalog-review","database_id":"fc9be213-d85a-4563-a557-00de7acac4ca"}],
  "vars": {
    "CLOUDFLARE_WORKER_NAME": "localjagoff-review",
    "COMMERCE_ENV": "preview",
    "SITE_URL": "https://localjagoff-review.localjagoff-site.workers.dev",
    "CHECKOUT_PAUSED": "true",
    "CUSTOMER_EMAIL_ENABLED": "false",
    "COMMUNICATIONS_ENABLED": "false",
    "CATALOG_SNAPSHOT_ENABLED": "true",
    "NATIVE_PRODUCT_ENABLED": "true",
    "COMMUNICATIONS_IDLE_GATE": "true",
    "COMMERCE_EXECUTOR_ENABLED": "true"
  },
  "triggers": {"crons": ["*/5 * * * *", "2 * * * *", "17 4 * * *", "1-56/5 * * * *"]},
  "observability": {"enabled":true,"head_sampling_rate":1}
}
